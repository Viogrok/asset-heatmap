# Copy actual values to ignored .dev.vars; use Sites secrets in production.
# Empty means NOT_CONFIGURED. No account/trading credentials are required for public crypto data.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_VERIFIED_DELAY_SECONDS=
LONGBRIDGE_SYMBOLS_JSON={}
LONGBRIDGE_GATEWAY_URL=
LONGBRIDGE_GATEWAY_TOKEN=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex
# Calendar's read-only endpoint must match the key's paper/live environment.
ALPACA_TRADING_ENV=paper
AKSHARE_GATEWAY_URL=
AKSHARE_GATEWAY_TOKEN=
COINGECKO_DEMO_API_KEY=
COINGECKO_MONTHLY_LIMIT=8000
CRYPTO_SYMBOLS_JSON={}
QUOTE_BINANCE_ENABLED=true
QUOTE_OKX_ENABLED=true
QUOTE_LEGACY_ENABLED=true
QUOTE_POLL_SECONDS=5
QUOTE_CRYPTO_TTL_SECONDS=10
QUOTE_EQUITY_TTL_SECONDS=30
QUOTE_MAX_STALE_SECONDS=86400
# Fair durable samples; 40 rows/minute keeps stream writes below 57,600/day.
QUOTE_STREAM_WRITES_PER_MINUTE=40
# Enable only after obtaining Invesco's permission for automated NAV access.
# Accepting website terms yourself is not publisher permission.
INVESCO_NAV_LICENSE_CONFIRMED=false
